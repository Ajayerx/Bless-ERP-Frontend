# LOCAL TESTING ONLY — copy this file to .env.local and run `npm run dev`.
#
# When set, the browser calls the local Frappe backend directly through a
# local HTTPS front (Caddy `tls internal` on https://blesserp.local), bypassing
# Vite's same-origin proxy. This produces a genuine cross-origin request so you
# can verify cookie/SameSite behavior matches production.
#
# NEVER commit .env.local (it is gitignored) and NEVER set this variable for a
# production build — api.config.ts ignores it whenever PROD is true.
VITE_LOCAL_CROSS_ORIGIN_TEST=true